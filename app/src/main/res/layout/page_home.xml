    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/home_vowifi"
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_item"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding_h"
            android:paddingTop="@dimen/card_padding_v"
            android:paddingEnd="@dimen/card_padding_h"
            android:paddingBottom="@dimen/card_padding_v">

            <TextView
                style="@style/Widget.App.FeatureTitle"
                android:text="@string/home_vowifi_title" />

            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/home_vowifi_desc" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

