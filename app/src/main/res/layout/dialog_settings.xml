<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding_h"
    android:paddingTop="@dimen/dialog_padding_top"
    android:paddingEnd="@dimen/dialog_padding_h">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/dialog_auto_check"
        style="@style/Widget.App.Switch"
        android:text="@string/dialog_auto_check" />

    <TextView
        style="@style/Widget.App.Description"
        android:layout_marginBottom="@dimen/gap_item"
        android:text="@string/dialog_auto_check_desc" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_check_now"
        style="@style/Widget.App.Button"
        android:text="@string/dialog_check_now" />

</LinearLayout>
