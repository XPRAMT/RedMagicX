<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_item">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding_h"
            android:paddingTop="@dimen/gap_xs"
            android:paddingEnd="@dimen/card_padding_h"
            android:paddingBottom="@dimen/card_padding_v">

            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/quick_intro" />
            <TextView
                style="@style/Widget.App.Title"
                android:text="@string/quick_engineering_title" />
            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/quick_engineering_desc" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_unlock"
                style="@style/Widget.App.Button"
                android:text="@string/quick_unlock" />
            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/quick_unlock_note" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_enter"
                style="@style/Widget.App.Button"
                android:text="@string/quick_enter" />
            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/quick_enter_note" />
            <TextView
                style="@style/Widget.App.Title"
                android:text="@string/quick_phone_title" />
            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/quick_phone_desc" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_phone_info"
                style="@style/Widget.App.Button"
                android:text="@string/quick_phone_info" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
