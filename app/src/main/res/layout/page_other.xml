<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_item">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding_h"
            android:paddingTop="@dimen/card_padding_v"
            android:paddingEnd="@dimen/card_padding_h"
            android:paddingBottom="@dimen/card_padding_v">

            <TextView
                style="@style/Widget.App.Title.First"
                android:text="@string/other_timeout_title" />
            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/other_timeout_desc" />
            <TextView
                android:id="@+id/other_timeout_label"
                style="@style/Widget.App.ValueLabel" />
            <com.google.android.material.slider.Slider
                android:id="@+id/other_timeout_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="1"
                android:valueTo="60"
                android:stepSize="1"
                app:labelBehavior="gone"
                app:tickVisible="false" android:contentDescription="@string/other_timeout_slider_desc" />
            <TextView
                style="@style/Widget.App.FieldLabel"
                android:text="@string/other_timeout_param_label" />
            <TextView
                style="@style/Widget.App.FieldValue"
                android:text="@string/other_timeout_param_value" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
