<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_item">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding_h"
            android:paddingTop="@dimen/card_padding_v"
            android:paddingEnd="@dimen/card_padding_h"
            android:paddingBottom="@dimen/card_padding_v">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bt_receiver_switch"
                style="@style/Widget.App.Switch"
                android:text="@string/bt_receiver" />
            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/bt_receiver_desc" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bt_auto_restart_switch"
                style="@style/Widget.App.Switch"
                android:text="@string/bt_auto_restart" />
            <TextView
                style="@style/Widget.App.Description"
                android:text="@string/bt_auto_restart_desc" />
            <TextView
                android:id="@+id/bt_status"
                style="@style/Widget.App.Status" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_restart_now"
                style="@style/Widget.App.Button"
                android:text="@string/bt_restart_now" />
            <TextView
                style="@style/Widget.App.FieldLabel"
                android:text="@string/bt_usage_label" />
            <TextView
                style="@style/Widget.App.FieldValue"
                android:text="@string/bt_usage_value" />
            <TextView
                style="@style/Widget.App.FieldLabel"
                android:text="@string/bt_scope_label" />
            <TextView
                style="@style/Widget.App.FieldValue"
                android:text="@string/bt_scope_value" />
            <TextView
                style="@style/Widget.App.FieldLabel"
                android:text="@string/bt_limits_label" />
            <TextView
                style="@style/Widget.App.FieldValue"
                android:text="@string/bt_limits_value" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
