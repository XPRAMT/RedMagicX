<resources>
    <string name="app_name">RedMagicX</string>
    <string name="module_description">RedMagicX: RedMagic system tweaks for VoWiFi UI, volume, Bluetooth receiver, assistant, launcher, themes, and ADB</string>
    <string name="home_vowifi_title">VoWiFi UI 修正</string>
    <string name="home_vowifi_desc">Wi-Fi Calling 設定、狀態列 VoWiFi 圖標、VoWiFi 圖標樣式</string>
    <string name="home_volume_title">音量條</string>
    <string name="home_volume_desc">自訂音量鍵步進，或改用 AOSP 音量條</string>
    <string name="home_bt_title">藍牙接收器</string>
    <string name="home_bt_desc">讓手機變成藍牙喇叭，其他手機可串流音樂過來（與藍牙耳機互斥），可自動重啟藍牙</string>
    <string name="home_assistant_title">魔姬手勢替換</string>
    <string name="home_assistant_desc">攔截 SystemUI 的小白條長按 Assistant 入口，改啟動系統動作、使用者 App 或系統 App</string>
    <string name="home_launcher_title">第三方啟動器</string>
    <string name="home_launcher_desc">設定預設 HOME，並從最近使用列表隱藏選定啟動器</string>
    <string name="home_theme_title">主題</string>
    <string name="home_theme_desc">在原廠主題預覽頁選擇允許套用的原廠資源類型</string>
    <string name="home_adb_title">ADB 控制中心</string>
    <string name="home_adb_desc">快速控制 USB 偵錯、ADB 偽裝與無線 ADB</string>
    <string name="home_quick_title">快速入口</string>
    <string name="home_quick_desc">自動撥號進入工程模式與手機資訊入口</string>
    <string name="home_other_title">其它</string>
    <string name="home_other_desc">未分類的系統設定與未來可擴充功能</string>
    <string name="vowifi_style_default">預設：不改 persist.custom.variant.id，通常使用 vowifi / vowifi_card1/2/12</string>
    <string name="vowifi_style_gen_bd">GEN_BD：等效 persist.custom.variant.id=GEN_BD，使用 bd_stat_vowifi / bd_vowifi_card1/2/12</string>
    <string name="vowifi_style_array_hook">Hook array：替換 ImsUpdateFeature 的 IMS icon array；已實測雙卡可用，依賴目前 ROM 方法名</string>
    <string name="vowifi_intro">此功能修正 VoWiFi UI 顯示。</string>
    <string name="vowifi_wfc">在設定顯示 VoWiFi 設定</string>
    <string name="vowifi_wfc_desc">在設定顯示 Wi-Fi Calling / VoWiFi 開關。仍需要 Pixel IMS 啟用 WFC。</string>
    <string name="vowifi_wfc_process_label">作用進程</string>
    <string name="vowifi_wfc_process_value">com.android.settings</string>
    <string name="vowifi_wfc_param_label">參數</string>
    <string name="vowifi_wfc_param_value">ro.vendor.feature.zte_feature_need_wfc_for_domestic=true</string>
    <string name="vowifi_open_wfc">打開 WiFi 通話設定</string>
    <string name="vowifi_icon">開啟狀態列 VoWiFi 圖標</string>
    <string name="vowifi_icon_desc">更改狀態列圖標來源，解決 VoWiFi 圖標無法顯示的問題。開啟後 4G 通話圖標由 HD 變為 VoLTE。修改只作用於 IMS / 訊號圖標相關呼叫，避免其它功能受到影響。</string>
    <string name="vowifi_icon_process_label">作用進程</string>
    <string name="vowifi_icon_process_value">com.android.systemui</string>
    <string name="vowifi_icon_param_label">參數</string>
    <string name="vowifi_icon_param_value">ro.vendor.mifavor.custom=abroad\nro.mifavor.custom=abroad</string>
    <string name="vowifi_style_title">VoWiFi 圖標樣式</string>
    <string name="vowifi_style_desc">控制 SystemUI 選用哪一套 VoWiFi / VoLTE 圖標。GEN_BD 模式會讀取下列參數；Hook array 模式則直接替換 IMS icon array。</string>
    <string name="vowifi_style_process_label">作用進程</string>
    <string name="vowifi_style_process_value">com.android.systemui</string>
    <string name="vowifi_style_param_label">參數</string>
    <string name="vowifi_style_param_value">persist.custom.variant.id=GEN_BD</string>
    <string name="vowifi_restart_title">重啟</string>
    <string name="vowifi_restart_desc">開關變更會自動保存到 LSPosed 設定。重啟 Settings / SystemUI 後才會重新讀取設定；重啟操作需要 root 權限。</string>
    <string name="vowifi_restart_settings">重啟 Settings</string>
    <string name="vowifi_restart_systemui">重啟 SystemUI</string>
    <string name="vowifi_restart_both">重啟 Settings + SystemUI</string>
    <string name="volume_step">啟用自訂音量步進</string>
    <string name="volume_step_desc">攔截媒體音量的音量鍵升降步進值，可設為 1 到 10。第一次載入可能需要重啟手機才能生效。</string>
    <string name="volume_step_process_label">作用進程</string>
    <string name="volume_step_process_value">android / System Framework</string>
    <string name="volume_step_methods_label">攔截方法</string>
    <string name="volume_step_methods_value">adjustStreamVolume\nadjustSuggestedStreamVolume</string>
    <string name="volume_undelay">音量變化通知即時送達</string>
    <string name="volume_undelay_desc">讓背景的音量面板 App（如 Ultra Volume）即時收到音量變化通知，不再被系統延後約 0.5 秒。只影響音量變化通知（VOLUME_CHANGED_ACTION），不影響其他廣播。修改後需重新開機生效。</string>
    <string name="volume_undelay_process_label">作用進程</string>
    <string name="volume_undelay_process_value">android / System Framework</string>
    <string name="volume_undelay_methods_label">攔截方法</string>
    <string name="volume_undelay_methods_value">BroadcastProcessQueue.updateRunnableAt</string>
    <string name="volume_aosp">使用AOSP音量條</string>
    <string name="volume_aosp_desc">開啟後改用 AOSP／legacy 音量條 layout（volume_dialog_legacy + volume_dialog_row），並跳過 MFV 專用初始化，避開 ColorSeekBarZTE。不會再強制 Adapt.enabled()=false。變更後按下方「重啟 SystemUI」或重新開機套用。</string>
    <string name="volume_aosp_process_label">作用進程</string>
    <string name="volume_aosp_process_value">com.android.systemui</string>
    <string name="volume_aosp_methods_label">攔截方法</string>
    <string name="volume_aosp_methods_value">getDialogLayoutResId / getRowLayoutResId\nmfvInitDialog / prepareDialog</string>
    <string name="volume_restart_systemui">重啟 SystemUI</string>
    <string name="bt_receiver">藍牙接收器模式</string>
    <string name="bt_receiver_desc">開啟後，這支手機會變成藍牙喇叭：其他手機配對後可以把音樂串流過來（SBC 或 AAC）。此模式下手機無法連接藍牙耳機，因為 Android 的藍牙堆疊無法同時穩定地擔任耳機端與喇叭端。設定會一直保留，重開機後仍然有效，直到你關閉為止。</string>
    <string name="bt_auto_restart">自動重啟藍牙</string>
    <string name="bt_auto_restart_desc">打開後，每次切換接收器模式都會自動把藍牙關閉再開啟，新模式立刻生效。需要 root 或 Shizuku；藍牙原本是關閉時不會被自動打開。關閉此選項時，切換模式後請自己把藍牙關閉再開啟。</string>
    <string name="bt_restart_now">立即重啟藍牙</string>
    <string name="bt_usage_label">使用方式</string>
    <string name="bt_usage_value">1. 開啟「藍牙接收器模式」，並讓藍牙重啟。2. 在這支手機的系統設定開啟「藍牙 &gt; 配對新裝置」，讓它可被搜尋。3. 在另一支手機配對這支手機並選它當音訊輸出。4. 要用耳機時，關閉接收器模式並讓藍牙重啟。</string>
    <string name="bt_scope_label">LSPosed 作用域</string>
    <string name="bt_scope_value">藍牙（com.android.bluetooth）。第一次使用請在 LSPosed 為 RedMagicX 勾選此作用域，然後讓藍牙重啟。</string>
    <string name="bt_limits_label">限制</string>
    <string name="bt_limits_value">只能解 SBC / AAC（沒有 LDAC、aptX、LHDC 的接收解碼）。對方看到的裝置類型仍是手機。接收模式下藍牙耳機無法連線。</string>
    <string name="assistant_tab_system">系統動作</string>
    <string name="assistant_tab_user">User App</string>
    <string name="assistant_tab_sysapp">System App</string>
    <string name="assistant">啟用魔姬手勢替換</string>
    <string name="assistant_desc">攔截小白條長按喚出魔姬助手的事件，改為啟動指定目標。可能需要重啟 SystemUI 才能生效。</string>
    <string name="assistant_process_label">作用進程</string>
    <string name="assistant_process_value">com.android.systemui</string>
    <string name="assistant_methods_label">攔截方法</string>
    <string name="assistant_methods_value">Context.sendBroadcast / sendBroadcastAsUser 發出的 event_Home_Longpressed</string>
    <string name="assistant_target_label">目前目標</string>
    <string name="assistant_target_value"></string>
    <string name="launcher_hide">從最近使用列表隱藏選定啟動器</string>
    <string name="launcher_hide_desc">避免使用第三方啟動器時，啟動器被補成最近任務卡片。只在手勢模式、目前任務為選定第三方 HOME 時生效。</string>
    <string name="launcher_hide_process_label">作用進程</string>
    <string name="launcher_hide_process_value">com.zte.mifavor.launcher</string>
    <string name="launcher_hide_methods_label">攔截方法</string>
    <string name="launcher_hide_methods_value">RecentsView#onGestureAnimationStart</string>
    <string name="launcher_change_title">更換啟動器</string>
    <string name="launcher_change_desc">優先使用 root 執行系統 set-home-activity；無 root 時可透過 Shizuku 授權，以 shell 權限套用。</string>
    <string name="launcher_change_cmd_label">指令</string>
    <string name="launcher_change_cmd_value">cmd package set-home-activity --user 0 &lt;component&gt;</string>
    <string name="launcher_empty">未找到可處理 HOME intent 的啟動器。</string>
    <string name="theme_select">啟用主題元素選擇</string>
    <string name="theme_select_desc">開啟後，原廠主題預覽頁會在自我介紹下方顯示系統資源、圖標、桌布與鎖屏選項，可分別選擇要套用的元素。</string>
    <string name="theme_splash">跳過開屏畫面</string>
    <string name="theme_splash_desc">啟動原廠主題 App 時跳過蒲公英開屏倒數，直接進入主題首頁。</string>
    <string name="theme_trial">移除試用時間限制</string>
    <string name="theme_trial_desc">免費試用主題、字體、桌布、動態桌布、熄屏時，不會有 5 分鐘時間限制。</string>
    <string name="theme_elements_label">可選元素</string>
    <string name="theme_elements_value">系統資源\n圖標\n桌布\n鎖屏</string>
    <string name="theme_process_label">作用進程</string>
    <string name="theme_process_value">com.zte.beautify\ncom.zte.beautifyadapter</string>
    <string name="theme_condition_label">生效條件</string>
    <string name="theme_condition_value">LSPosed 需要勾選上述兩個作用域。變更作用域後請重新開啟原廠主題 App。</string>
    <string name="theme_open_beautify">打開下載佈景主題</string>
    <string name="adb_port_hint">自訂連接埠</string>
    <string name="adb_intro">以下功能皆需 root 權限。</string>
    <string name="adb_developer">啟用 ADB（開發人員選項）</string>
    <string name="adb_developer_desc">快速控制開發人員選項的「USB 偵錯」開關。關閉後也會中斷無線 ADB。</string>
    <string name="adb_fake">偽裝 ADB 狀態</string>
    <string name="adb_fake_desc">寫入 adb_enabled=2。系統會把大於零的值視為 ADB 已開啟，只能欺騙精確檢查 adb_enabled 是否等於 1 的部分 App。對於會檢查非零值或其它偵錯狀態的 App 無效。</string>
    <string name="adb_system_label">系統狀態</string>
    <string name="adb_system_value">讀取中...</string>
    <string name="adb_wireless">啟用無線 ADB</string>
    <string name="adb_wireless_desc">立即設定 ADB TCP 連接埠並重啟 adbd。開啟後會保留使用者設定；ADB 已開啟時每 5 秒確認一次，未執行時會自動恢復。</string>
    <string name="adb_status_label">狀態</string>
    <string name="adb_status_value">讀取中...</string>
    <string name="adb_endpoint_label">IP 位址</string>
    <string name="adb_endpoint_value">讀取中...</string>
    <string name="adb_command_label">連線指令</string>
    <string name="adb_command_value">-</string>
    <string name="adb_copy">複製連線指令</string>
    <string name="adb_apply">套用</string>
    <string name="adb_install">允許 ADB 安裝</string>
    <string name="adb_install_desc">控制開發人員選項的「允許 USB 安裝」，開啟時寫入 adb_install_enabled=1。</string>
    <string name="quick_intro">以下功能可使用 root 或 Shizuku 授權。</string>
    <string name="quick_engineering_title">工程模式</string>
    <string name="quick_engineering_desc">首次使用時，請先解鎖工程模式；完成解鎖後可直接進入工程模式主選單。</string>
    <string name="quick_unlock">解鎖工程模式</string>
    <string name="quick_unlock_note">模擬輸入 *983*673636#。只需要在首次使用時執行。</string>
    <string name="quick_enter">進入工程模式</string>
    <string name="quick_enter_note">透過原廠電話鍵盤模擬輸入 *983*0#，完成工程模式初始化並開啟主選單。</string>
    <string name="quick_phone_title">手機資訊</string>
    <string name="quick_phone_desc">開啟系統電話服務的手機資訊頁面，可查看行動網路、IMS 與無線電狀態。</string>
    <string name="quick_phone_info">開啟手機資訊</string>
    <string name="other_timeout_title">螢幕亮屏時間設定</string>
    <string name="other_timeout_desc">設定螢幕無操作後維持亮屏的時間，範圍為 1 到 60 分鐘。每次進入此頁面時會重新讀取系統目前值。套用優先使用 root；沒有 root 時改用 Shizuku。</string>
    <string name="other_timeout_param_label">系統參數</string>
    <string name="other_timeout_param_value">Settings.System.screen_off_timeout</string>
    <string name="other_timeout_slider_desc">螢幕亮屏時間</string>
    <string name="dialog_auto_check">自動檢測更新</string>
    <string name="dialog_auto_check_desc">開啟後，啟動 App 時會檢查 GitHub 最新正式 Release。偵測到新版本時會顯示通知。</string>
    <string name="dialog_check_now">手動檢查更新</string>
</resources>
